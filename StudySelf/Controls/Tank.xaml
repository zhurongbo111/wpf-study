<UserControl x:Class="StudySelf.Controls.Tank"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudySelf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="180">
    <Grid>
        <Path Margin="5,25,0,0" Fill="#7BB7FD" Data="M0,0 A60 60 0 0 0 60 0 A60 60 60 0 1 120 0 A60 60 120 0 0 180 0"></Path>
        <Border VerticalAlignment="Top" Background="Orange" Height="5" CornerRadius="2" ></Border>
        <Border Height="235" Width="170" Margin="0,5,0,0" VerticalAlignment="Top" BorderBrush="#888" BorderThickness="1,0,1,1" >
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#DDD" Offset="0"/>
                    <GradientStop Color="#1DDD" Offset="0.3"/>
                    <GradientStop Color="#1DDD" Offset="0.7"/>
                    <GradientStop Color="#DDD" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
            
    </Grid>
</UserControl>
