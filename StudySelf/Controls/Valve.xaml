<UserControl x:Class="StudySelf.Controls.Valve"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StudySelf.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="40">
    <Viewbox>
        <Grid Height="40" Width="40">
            <Border Height="10" BorderBrush="Gray" BorderThickness="2,0" >
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#ddd" Offset="0" />
                        <GradientStop Color="#fff" Offset="0.5" />
                        <GradientStop Color="#ddd" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Height="20" Width="20" CornerRadius="10">
                <Border.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#fff" Offset="0" />
                        <GradientStop Color="#ddd" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Height="8" Width="8" CornerRadius="4" Background="Orange" />
            <Border Height="20" Width="4" Background="Orange" VerticalAlignment="Bottom" CornerRadius="0,0,10,10">
                <Border.RenderTransform>
                    <RotateTransform CenterX="2" Angle="0" x:Name="sw" ></RotateTransform>
                </Border.RenderTransform>
            </Border>
        </Grid>
    </Viewbox>
   
</UserControl>
