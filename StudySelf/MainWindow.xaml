<Window x:Class="StudySelf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StudySelf"
        mc:Ignorable="d"
        Title="朝夕教育-组态监控系统" Height="450" Width="800">
    <WindowChrome.WindowChrome>
        <WindowChrome NonClientFrameEdges="None" UseAeroCaptionButtons="False" ></WindowChrome>
    </WindowChrome.WindowChrome>
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#15212F" Offset="0"/>
            <GradientStop Color="#1D2D3E" Offset="0.6"/>
            <GradientStop Color="#15212F" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid.Background>
            <VisualBrush Viewport="0,0,10,10"
                         ViewportUnits="Absolute"
                         TileMode="Tile"
                         Opacity="0.3">
                <VisualBrush.Visual>
                    <Border Width="10"
                            Height="10"
                            BorderThickness="1,1,0,0"
                            BorderBrush="#1FFF"/>
                </VisualBrush.Visual>
            </VisualBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Height="Auto" >
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" >
                    <Image Source="/Assets/Images/Logo_64.png" Height="28" Width="28" Margin="10,0" ></Image>
                    <StackPanel>
                        <TextBlock Text="朝夕教育-智慧工业" FontSize="12" Foreground="White"></TextBlock>
                        <TextBlock Text="ZHAOXIEDU-SMART" FontSize="8" Foreground="White" Opacity="0.6" >
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="1.3" ></ScaleTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                        <ColumnDefinition Width="*" MaxWidth="600"></ColumnDefinition>
                        <ColumnDefinition Width="100"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备介绍" Height="30" FontSize="14" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="White" Opacity="0.6" ></TextBlock>
                    
                    <Path Grid.Column="0" Grid.ColumnSpan="3" Data="M0,0 0.03,0.66 C0.047,1 0.047,1 0.093,1 L0.907,1 C0.953,1 0.953,1 0.97,0.66 L1,0"
                          StrokeThickness="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Center"
                          Width="Auto"
                          Height="30"
                          Stretch="Fill">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0FFF" Offset="0.3"/>
                                <GradientStop Color="#7FFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                    </Path>
                    <Path Grid.Column="1" Data="M0,0 0.03,0.66 C0.047,1 0.047,1 0.093,1 L0.907,1 C0.953,1 0.953,1 0.97,0.66 L1,0"
                          StrokeThickness="1"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Center"
                          Width="Auto"
                          Height="40"
                          Stretch="Fill">
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0FFF" Offset="0"/>
                                <GradientStop Color="#7FFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Fill>
                            <RadialGradientBrush Center="0.5,1" GradientOrigin="0.5,1">
                                <GradientStop Color="#385FB0" Offset="0"/>
                                <GradientStop Color="#152230" Offset="1"/>
                            </RadialGradientBrush>
                        </Path.Fill>
                    </Path>
                    <TextBlock Grid.Column="1" Text="工厂设备机械管理监控" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"></TextBlock>
                    <TextBlock Grid.Column="2" Text="系统设置" Height="30" FontSize="14" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="White" Opacity="0.6"></TextBlock>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" >
                    <StackPanel>
                        <TextBlock Text="20:00:00" FontSize="12" Foreground="White" >
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="1.3" ></ScaleTransform>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="周一 2025/06/02" FontSize="8" Foreground="White" Opacity="0.6"></TextBlock>
                    </StackPanel>
                    <Button Content="退出系统" Margin="10,0" FontSize="12" Height="30" Width="80" Foreground="White" >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="M10 0 0 30 10 30" Fill="Orange" Stretch="Fill" Name="path"/>
                                    <Border Background="Orange" Grid.Column="1" CornerRadius="0,5,5,0" Name="border"/>
                                    <ContentPresenter Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
